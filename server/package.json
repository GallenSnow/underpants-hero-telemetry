{
  "name": "uh-telemetry-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor de telemetria do Underpants Hero (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "migrate:local": "wrangler d1 migrations apply uh-telemetry --local",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
